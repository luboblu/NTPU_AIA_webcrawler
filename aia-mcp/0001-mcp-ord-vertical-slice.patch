+name: Deploy MCP to staging
+
+# 只能在 Actions 頁面手動觸發，部署到 staging，不影響 aia.ntpu.ai。
+# 需要先完成 mcp/README.md 的「第一次設定」（建立 staging 的 D1 與 R2，並填入 database_id）。
+on:
+  workflow_dispatch:
+
+concurrency:
+  group: deploy-mcp-staging
+  cancel-in-progress: false
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    environment: staging
+    defaults:
+      run:
+        working-directory: mcp
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/setup-node@v7
+        with:
+          node-version: "22"
+      - run: npm ci
+      - run: npm run typecheck
+      - run: npm test
+      - name: Check staging D1 id is configured
+        run: |
+          if grep -q REPLACE_WITH_STAGING_D1_ID wrangler.ingest.jsonc wrangler.mcp.jsonc; then
+            echo "::error::尚未填入 staging 的 D1 database_id，請先依 mcp/README.md 完成第一次設定"
+            exit 1
+          fi
+      - name: Apply D1 migrations (staging)
+        env:
+          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
+        run: npm run db:migrate:staging
+      - name: Deploy ingest + MCP workers (staging)
+        env:
+          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
+        run: npm run deploy:staging
