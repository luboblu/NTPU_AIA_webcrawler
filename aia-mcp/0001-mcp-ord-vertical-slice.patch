+name: MCP ingest + server tests
+
+# 只檢查 mcp/，不部署任何東西；正式站的部署仍只由 deploy.yml 負責。
+on:
+  pull_request:
+    paths:
+      - "mcp/**"
+      - ".github/workflows/mcp-ci.yml"
+  push:
+    branches: [main]
+    paths:
+      - "mcp/**"
+      - ".github/workflows/mcp-ci.yml"
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    defaults:
+      run:
+        working-directory: mcp
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/setup-node@v7
+        with:
+          node-version: "22"
+      - run: npm ci
+      - run: npm run typecheck
+      - run: npm test
+      # 確認兩個 Worker 都能打包（不會真的部署）
+      - run: npx wrangler deploy --dry-run --config wrangler.ingest.jsonc --outdir /tmp/ingest
+      - run: npx wrangler deploy --dry-run --config wrangler.mcp.jsonc --outdir /tmp/mcp
