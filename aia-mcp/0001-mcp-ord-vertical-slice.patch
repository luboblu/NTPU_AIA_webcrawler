+    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging --config wrangler.ingest.jsonc",
+    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production --config wrangler.ingest.jsonc",
